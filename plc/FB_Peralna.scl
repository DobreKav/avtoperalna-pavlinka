// Автоперална Павлинка: self-service bay (foam + water) for a Siemens S7-1200 (FW 4.2 or newer).
// The laptop is the Modbus TCP server (PeralnaAgent.exe, port 502); this PLC is the client.
// addons\PlcEmulator.exe on the laptop runs exactly this logic, so it can be tested without the PLC.
//
// TIA Portal: Program blocks > External source files > Add new external file > this file,
// right click > "Generate blocks from source". Then call "FB_Peralna" from OB1 (see bottom).
//
// Before downloading, set the laptop IP address in the four ADDR lines below and check
// InterfaceId: it is the "Hardware identifier" of the PLC's PROFINET interface
// (Device configuration > PROFINET interface > System constants, usually 64).
//
// Laptop registers read here (40001 = register 0):
//   Regs[0] enable 1/0 · Regs[1] seconds left · Regs[2] balance · Regs[3] charged
//   Regs[4] status     · Regs[5] heartbeat    · Regs[6] minutes left
//   Regs[20] name length · Regs[21..52] card holder name, one UTF-16 character per register
//
// Touch panel (WinCC, e.g. KTP700 Basic): use the instance DB "FB_Peralna_DB".
//   Text field      CardName (WString)          - card holder name
//   I/O field       SecondsLeft (UInt)          - format 999 or use MinutesLeft/SecondsPart as mm:ss
//   I/O field       Balance (UInt)              - "Салдо"
//   Symbolic field  Status (UInt) + text list   - 0 Стави картичка · 1 Работи · 2 Парите се потрошени ·
//                                                 3 Нема доволно пари · 4 Непозната картичка ·
//                                                 5 Блокирана картичка · 6 Грешка на серверот ·
//                                                 7 Нема читач · 8 Картичката не се чита
//   Buttons         HmiFoam / HmiWater / HmiStop - event Press: SetBit, Release: ResetBit
//   Lamps           Foam, Water, CommOk; Program (0 none, 1 ПЕНА, 2 ВОДА) for the active button colour

FUNCTION_BLOCK "FB_Peralna"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
   VAR_INPUT
      BtnFoam : Bool;    // push button "ПЕНА" on the bay
      BtnWater : Bool;   // push button "ВОДА"
      BtnStop : Bool;    // push button "СТОП" (pauses the spray; the card is billed until it is removed)
   END_VAR

   VAR_OUTPUT
      Foam : Bool;          // output to the foam pump / valve
      Water : Bool;         // output to the water pump / valve
      Enabled : Bool;       // card inside, money on it, link to the laptop is healthy
      CommOk : Bool;        // laptop heartbeat seen within the last 5 s
      Program : Int;        // 0 none, 1 foam, 2 water
      CardName : WString[32];
      SecondsLeft : UInt;
      MinutesLeft : UInt;
      SecondsPart : UInt;   // SecondsLeft MOD 60, for an mm:ss display
      SecondsBCD : Word;    // 4-digit BCD of SecondsLeft (max 9999) for a digital seconds display on a QW
      Balance : UInt;       // denars on the card
      Charged : UInt;       // denars charged this session
      Status : UInt;        // see the text list above
      CommError : Bool;     // MB_CLIENT reported an error (see CommStatus)
      CommStatus : Word;
   END_VAR

   VAR
      HmiFoam : Bool;       // written by the touch panel buttons
      HmiWater : Bool;
      HmiStop : Bool;
      Client : MB_CLIENT;
      Conn : TCON_IP_v4;
      Regs : Array[0..52] of Word;
      PollTimer : TON;
      WatchdogTimer : TON;
      LastHeartbeat : Word;
      Fresh : Bool;
   END_VAR

   VAR_TEMP
      i : Int;
      len : Int;
      digits : UInt;
   END_VAR

BEGIN
   // ── Connection to the laptop ─────────────────────────────────
   #Conn.InterfaceId := 64;               // PROFINET interface hardware id
   #Conn.ID := 1;                         // any free connection id
   #Conn.ConnectionType := 16#0B;         // TCP
   #Conn.ActiveEstablished := TRUE;       // the PLC opens the connection (client)
   #Conn.RemoteAddress.ADDR[1] := 192;    // laptop IP address
   #Conn.RemoteAddress.ADDR[2] := 168;
   #Conn.RemoteAddress.ADDR[3] := 1;
   #Conn.RemoteAddress.ADDR[4] := 10;
   #Conn.RemotePort := 502;
   #Conn.LocalPort := 0;

   // Read registers 0..52 every 300 ms.
   #PollTimer(IN := NOT #PollTimer.Q, PT := T#300MS);
   #Client(REQ := #PollTimer.Q,
           DISCONNECT := FALSE,
           MB_MODE := 0,                  // read
           MB_DATA_ADDR := 40001,         // holding register 0
           MB_DATA_LEN := 53,
           MB_DATA_PTR := #Regs,
           CONNECT := #Conn);

   IF #Client.ERROR THEN
      #CommError := TRUE;
      #CommStatus := #Client.STATUS;
   ELSIF #Client.DONE THEN
      #CommError := FALSE;
   END_IF;

   // ── Watchdog: the laptop bumps Regs[5] every second ──────────
   // No new heartbeat for 5 s (laptop frozen, cable out, agent closed) = stop.
   #Fresh := #Client.DONE AND (#Regs[5] <> #LastHeartbeat);
   IF #Fresh THEN
      #LastHeartbeat := #Regs[5];
   END_IF;
   #WatchdogTimer(IN := NOT #Fresh, PT := T#5S);
   #CommOk := NOT #WatchdogTimer.Q;

   // ── Bay ──────────────────────────────────────────────────────
   #Enabled := #CommOk AND (#Regs[0] = 1);

   IF NOT #Enabled OR #BtnStop OR #HmiStop THEN
      #Program := 0;
   ELSIF #BtnFoam OR #HmiFoam THEN
      #Program := 1;
   ELSIF #BtnWater OR #HmiWater THEN
      #Program := 2;
   END_IF;

   #Foam := #Enabled AND (#Program = 1);
   #Water := #Enabled AND (#Program = 2);

   // ── Values for the touch panel and the seconds display ───────
   #Balance := WORD_TO_UINT(#Regs[2]);
   #Charged := WORD_TO_UINT(#Regs[3]);
   #Status := WORD_TO_UINT(#Regs[4]);
   IF #Enabled THEN
      #SecondsLeft := WORD_TO_UINT(#Regs[1]);
   ELSE
      #SecondsLeft := 0;
   END_IF;
   #MinutesLeft := #SecondsLeft / 60;
   #SecondsPart := #SecondsLeft MOD 60;

   #digits := #SecondsLeft;
   IF #digits > 9999 THEN
      #digits := 9999;
   END_IF;
   #SecondsBCD := UINT_TO_WORD(#digits MOD 10)
      OR SHL(IN := UINT_TO_WORD((#digits / 10) MOD 10), N := 4)
      OR SHL(IN := UINT_TO_WORD((#digits / 100) MOD 10), N := 8)
      OR SHL(IN := UINT_TO_WORD(#digits / 1000), N := 12);

   // Card holder name (Cyrillic): one UTF-16 character per register.
   #len := WORD_TO_INT(#Regs[20]);
   IF #len > 32 THEN
      #len := 32;
   END_IF;
   #CardName := WSTRING#'';
   FOR #i := 0 TO #len - 1 DO
      #CardName := CONCAT(IN1 := #CardName, IN2 := WCHAR_TO_WSTRING(WORD_TO_WCHAR(#Regs[21 + #i])));
   END_FOR;
END_FUNCTION_BLOCK

// ── Call in OB1 (Main), in SCL or as a box in LAD ──────────────
//
//   "FB_Peralna_DB"(BtnFoam  := "I_Pena",
//                   BtnWater := "I_Voda",
//                   BtnStop  := "I_Stop",
//                   Foam     => "Q_Pena",
//                   Water    => "Q_Voda",
//                   SecondsBCD => "QW_Sekundarnik");
//
// Tags (example): I_Pena %I0.0, I_Voda %I0.1, I_Stop %I0.2, Q_Pena %Q0.0, Q_Voda %Q0.1,
// QW_Sekundarnik %QW2 (4-digit BCD display; leave it out if the display is driven by the touch panel only)
